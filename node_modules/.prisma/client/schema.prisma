generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int            @id @default(autoincrement())
  email            String         @unique @db.VarChar(100)
  password         String         @db.VarChar(50)
  nickname         String?        @db.VarChar(50)
  avatarUrl        String?        @map("avatar_url") @db.VarChar(500)
  age              Int?
  gender           String?        @db.VarChar(20)
  job              String?        @db.VarChar(255)
  role             String?        @default("user") @db.VarChar(50)
  otp              String?        @db.VarChar(20)
  otpExpiry        DateTime?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  emotionDiaries   EmotionDiary[]
  assessments      Assessment[]
  chatSessions     ChatSession[]

  @@map("users")
}

model EmotionIcon {
  id             String         @id @db.VarChar(36)
  name           String         @db.VarChar(100)
  icon           String?        @db.VarChar(255)
  defaultScore   Int            @default(0) @map("default_score")
  emotionDiaries EmotionDiary[]

  @@map("emotion_icons")
}

model EmotionDiary {
  id          String       @id @db.VarChar(36)
  userId      Int          @map("user_id")
  iconId      String?      @map("icon_id") @db.VarChar(36)
  iconUrl     String?      @map("icon_url") @db.VarChar(255)
  moodScore   Int?         @default(0) @map("mood_score")
  note        String?      @db.Text
  diaryDate   DateTime     @map("diary_date") @db.Date
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  emotionIcon EmotionIcon? @relation(fields: [iconId], references: [id], onDelete: SetNull)

  @@map("emotion_diaries")
}

model TestType {
  id          Int          @id @default(autoincrement())
  code        String       @unique @db.VarChar(50)
  description String?      @db.Text
  testScales  TestScale[]
  questions   Question[]
  assessments Assessment[]

  @@map("test_types")
}

model TestScale {
  id       Int      @id @default(autoincrement())
  testCode String   @map("test_code") @db.VarChar(50)
  label    String?  @db.VarChar(255)
  value    Int
  testType TestType @relation(fields: [testCode], references: [code], onDelete: Cascade)

  @@unique([testCode, value])
  @@map("test_scales")
}

model Question {
  id            Int      @id @default(autoincrement())
  content       String   @db.Text
  questionOrder Int      @map("question_order")
  testCode      String   @map("test_code") @db.VarChar(50)
  category      String?  @db.VarChar(255)
  testType      TestType @relation(fields: [testCode], references: [code], onDelete: Cascade)

  @@map("questions")
}

model Assessment {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  testTypeCode String   @map("test_type") @db.VarChar(50)
  finalScore   Int?     @default(0) @map("final_score")
  resultDetail Json?    @map("result_detail")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  testType     TestType @relation(fields: [testTypeCode], references: [code])

  @@map("assessments")
}

model ChatSession {
  sessionId      Int           @id @default(autoincrement()) @map("session_id")
  userId         Int           @map("user_id")
  title          String?       @db.VarChar(255)
  sessionSummary String?       @map("session_summary") @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatMessages   ChatMessage[]

  @@map("chat_sessions")
}

enum Sender {
  USER
  AI
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  SYSTEM
}

model ChatMessage {
  messageId   Int          @id @default(autoincrement()) @map("message_id")
  sessionId   Int          @map("session_id")
  sender      Sender
  content     String       @db.Text
  messageType MessageType? @default(TEXT) @map("message_type")
  tokensUsed  Int?         @default(0) @map("tokens_used")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  chatSession ChatSession  @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@map("chat_messages")
}

model Category {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  thumbnail   String?
  createdAt   DateTime   @default(now())
  exercises   Exercise[]
}

model ExerciseCategory {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  description String?  @db.Text
  thumbnail   String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("exercise_categories")
}

model Exercise {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  description String?  @db.Text
  instruction String?  @db.Text
  videoUrl    String   @map("video_url") @db.VarChar(500)
  thumbnail   String?  @db.VarChar(500)
  categoryId  Int      @map("category_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("exercises")
}

model SupportType {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(100)
  code             String            @unique @db.VarChar(50)
  description      String?           @db.Text
  supportLocations SupportLocation[]

  @@map("support_types")
}

model SupportLocation {
  id          Int         @id @default(autoincrement())
  name        String      @db.VarChar(255)
  phoneNumber String?     @map("phone_number") @db.VarChar(50)
  address     String?     @db.VarChar(500)
  note        String?     @db.Text
  typeId      Int         @map("type_id")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  supportType SupportType @relation(fields: [typeId], references: [id])

  @@map("support_locations")
}
